{
    "name": "formax-ui",
    "version": "2.1.0",
    "description": "Production-ready React form workflows for React Hook Form, Zod, and modern dashboards",
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "bin": {
        "formax-ui": "dist/cli.js"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        },
        "./ai": {
            "types": "./dist/ai.d.ts",
            "import": "./dist/ai.mjs",
            "require": "./dist/ai.js"
        },
        "./workflow": {
            "types": "./dist/workflow.d.ts",
            "import": "./dist/workflow.mjs",
            "require": "./dist/workflow.js"
        },
        "./legacy": {
            "types": "./dist/legacy.d.ts",
            "import": "./dist/legacy.mjs",
            "require": "./dist/legacy.js"
        },
        "./templates": {
            "types": "./dist/templates.d.ts",
            "import": "./dist/templates.mjs",
            "require": "./dist/templates.js"
        },
        "./intelligence": {
            "types": "./dist/intelligence.d.ts",
            "import": "./dist/intelligence.mjs",
            "require": "./dist/intelligence.js"
        },
        "./package.json": "./package.json",
        "./styles.css": "./dist/styles.css",
        "./legacy.css": "./dist/legacy.css"
    },
    "files": [
        "dist"
    ],
    "sideEffects": [
        "./dist/styles.css",
        "./dist/legacy.css",
        "./src/styles/globals.css"
    ],
    "scripts": {
        "build": "node build-docs.js",
        "clean:dist": "node scripts/clean-dist.js",
        "build:lib": "npm run clean:dist && rollup -c rollup.config.mjs",
        "dev": "rollup -c rollup.config.mjs -w",
        "playground": "cd playground && npm run dev",
        "docs:api": "node scripts/generate-api-docs.js",
        "type-check": "tsc --noEmit",
        "lint": "eslint src --ext .ts,.tsx",
        "lint:fix": "eslint src --ext .ts,.tsx --fix",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "playwright test",
        "test:package": "node scripts/verify-package.js",
        "quality": "npm run lint && npm run type-check && npm run test && npm run build:lib && npm run test:package",
        "changeset": "changeset",
        "prepublishOnly": "npm run build:lib"
    },
    "keywords": [
        "react",
        "forms",
        "ui",
        "components",
        "typescript",
        "tailwind",
        "accessibility",
        "validation"
    ],
    "author": "Formax UI Team",
    "license": "MIT",
    "peerDependencies": {
        "@hookform/resolvers": ">=3.0.0",
        "react": ">=18.0.0",
        "react-dom": ">=18.0.0",
        "react-hook-form": ">=7.0.0",
        "zod": ">=3.0.0"
    },
    "devDependencies": {
        "@changesets/cli": "^2.27.12",
        "@hookform/resolvers": "^5.4.0",
        "@playwright/test": "^1.49.1",
        "@rollup/plugin-commonjs": "^25.0.7",
        "@rollup/plugin-node-resolve": "^15.2.3",
        "@rollup/plugin-typescript": "^11.1.5",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.1.0",
        "@types/jest-axe": "^3.5.9",
        "@types/node": "^24.0.1",
        "@types/react": "^18.2.45",
        "@types/react-datepicker": "^6.2.0",
        "@types/react-dom": "^18.2.18",
        "@typescript-eslint/eslint-plugin": "^6.15.0",
        "@typescript-eslint/parser": "^6.15.0",
        "autoprefixer": "^10.4.16",
        "eslint": "^8.56.0",
        "eslint-plugin-react": "^7.33.2",
        "eslint-plugin-react-hooks": "^4.6.0",
        "jest-axe": "^9.0.0",
        "jsdom": "^25.0.1",
        "postcss": "^8.4.32",
        "react-hook-form": "^7.54.2",
        "rollup": "^4.9.1",
        "rollup-plugin-dts": "^6.1.0",
        "rollup-plugin-peer-deps-external": "^2.2.4",
        "rollup-plugin-postcss": "^4.0.2",
        "tailwindcss": "^3.4.0",
        "tslib": "^2.6.2",
        "typescript": "^5.3.3",
        "vitest": "^1.6.1",
        "zod": "^4.4.3"
    },
    "dependencies": {
        "clsx": "^2.0.0",
        "lucide-react": "^0.303.0",
        "react-datepicker": "^4.25.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Formax-UI/dev.git"
    },
    "bugs": {
        "url": "https://github.com/Formax-UI/dev/issues"
    },
    "homepage": "https://github.com/Formax-UI/dev#readme"
}
